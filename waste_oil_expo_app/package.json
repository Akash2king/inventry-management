{
  "name": "waste-oil-expo-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "description": "Chem-Solv Inventory — native Expo / React Native mobile app",
  "type": "commonjs",
  "scripts": {
    "start": "expo start --clear",
    "expo:start": "expo start --clear",
    "expo:android": "bash -c 'source scripts/android-env.sh && npx expo run:android'",
    "expo:ios": "expo run:ios",
    "expo:prebuild:android": "expo prebuild --platform android --clean",
    "android:setup-sdk": "bash scripts/setup-android-sdk.sh",
    "android:apk:eas": "eas build --platform android --profile preview",
    "android": "bash scripts/build-android-release-apk.sh",
    "android:dev": "bash -c 'source scripts/android-env.sh && npx expo run:android'",
    "android:release": "bash scripts/build-android-release-apk.sh",
    "android:install": "bash -c 'source scripts/android-env.sh && cd android && ./gradlew assembleRelease -x lint && adb install -r app/build/outputs/apk/release/app-release.apk && adb shell am start -n com.chemsolv.inventory/.MainActivity'",
    "ios": "expo run:ios",
    "debug:adb": "bash scripts/adb-debug-push.sh",
    "debug:adb:status": "bash scripts/adb-debug-push.sh status",
    "dev:metro": "bash -c 'source scripts/android-env.sh && CHOKIDAR_USEPOLLING=1 WATCHMAN_DISABLE=1 adb reverse tcp:8081 tcp:8081 2>/dev/null; npx expo start --dev-client --host lan --clear'",
    "dev:backend": "bash ../waste_oil_backend/scripts/run-backend.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "base64-js": "^1.5.1",
    "expo": "~54.0.34",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "onesignal-expo-plugin": "2.6.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-onesignal": "5.4.7",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {}
}
