{
  "expo": {
    "name": "Chem-Solv Inventory",
    "slug": "waste-oil-inventory-expo",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/app-logo.png",
    "splash": {
      "image": "./src/assets/app-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f1f4f8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.chemsolv.inventory",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-logo.png",
        "backgroundColor": "#f1f4f8"
      }
    },
    "ios": {
      "bundleIdentifier": "com.chemsolv.inventory",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Chem-Solv Inventory shows workflow updates (records, SLA, sign-in notices) in your notification center."
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "workflow-notifications",
          "color": "#16a34a"
        }
      ],
      "expo-background-fetch",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "ed9b3cba-8199-4917-bdd5-b3648b6cbf5a"
      }
    },
    "owner": "akash2king-org"
  }
}
