{
  "expo": {
    "name": "Chem-Solv Inventory",
    "slug": "waste-oil-inventory-expo",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.chemsolv.inventory"
    },
    "ios": {
      "bundleIdentifier": "com.chemsolv.inventory",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ed9b3cba-8199-4917-bdd5-b3648b6cbf5a"
      }
    },
    "owner": "akash2king-org"
  }
}
