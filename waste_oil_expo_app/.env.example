# Copy to .env
# ── Vite (browser build only): injected as VITE_*
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# ── Native Expo app: same Django API, embedded at build via EXPO_PUBLIC_*
# Phone/tablet on the same Wi‑Fi as the PC running Django:
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000/api/v1
#
# Android emulator → host PC: EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
#
# You can also set API URL inside the app: Login → API Settings (saved on device).
# Cleartext HTTP is enabled for LAN dev (app.json / expo-build-properties). Use HTTPS in production.

# Push (Firebase only — not Expo Push): in Firebase Console create an Android app with package
# com.chemsolv.inventory, download google-services.json into waste_oil_expo_app/, then add
# "googleServicesFile": "./google-services.json" under expo.android in app.json. Backend needs
# FCM_ENABLED=true and FCM_SERVICE_ACCOUNT_FILE (see waste_oil_backend/.env.example).

# Optional legacy web dev with Vite (browser only):
# npm run dev  # Vite on 1420 — not used by the native shell anymore

# ---------------------------------------------------------------------------
# Open as desktop app
# ---------------------------------------------------------------------------
# Terminal 1 (backend):
#   cd waste_oil_backend
#   python manage.py seed_workflow_demo
#   python manage.py runserver 0.0.0.0:8000
# Terminal 2 (Tauri + Vite):
#   cd waste_oil_desktop-TAURI
#   npm run dev
# A Tauri window should open. Use the demo logins below.

# ---------------------------------------------------------------------------
# Demo workflow credentials (after seed_workflow_demo)
# ---------------------------------------------------------------------------
# Same password for every account (default): Demo12345
#
#   Stage   Username      Role        Use for
#   -----   --------      ----        -------
#   1       storeman      storeman    Create records, forward from stage 1
#   2       treatment     treatment   Queue + forward/return at stage 2
#   3       waste_admin   admin       Queue + forward/return at stage 3
#   4       manager       manager     Queue + forward/return at stage 4
#   5       gm            gm          Final approve (locks record)
#
# Custom password:
#   python manage.py seed_workflow_demo --password YourPassHere

# ---------------------------------------------------------------------------
# Sample record (create as storeman - POST /api/v1/records/ or New Record UI)
# ---------------------------------------------------------------------------
# {
#   "vendor_name": "Acme Recycling Ltd",
#   "vendor_contact": "+1-555-0100",
#   "quantity_litres": "1250.50",
#   "oil_type": "Used hydraulic oil ISO 46",
#   "collection_date": "2026-03-01",
#   "remarks": "Demo batch - sealed drums, MSDS on file."
# }
#
# Workflow smoke test:
# 1) Login as storeman - New Record - submit sample above - Forward (note optional).
# 2) Login as treatment - Queue - open record - Forward.
# 3) Login as waste_admin - Forward.
# 4) Login as manager - Forward.
# 5) Login as gm - Final forward - record completes (locked).
