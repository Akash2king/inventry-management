# Copy to .env — native Expo app only

# Django API (same Wi‑Fi as the phone). Override anytime in Settings.
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000/api/v1
#
# Android emulator → host PC:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Push (OneSignal) — see Docs/PUSH_NOTIFICATIONS.md
EXPO_PUBLIC_ONESIGNAL_APP_ID=e744024a-08b5-4703-a3ed-af0ac17e907f
# Backend needs ONESIGNAL_APP_ID + ONESIGNAL_REST_API_KEY in waste_oil_backend/.env

# Run:
#   Terminal 1: cd waste_oil_backend && python manage.py runserver 0.0.0.0:8000
#   Terminal 2: cd waste_oil_expo_app && npm start
#   Phone: open Chem-Solv Inventory (dev client / release APK)
