# Django
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
# Local PostgreSQL:
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/waste_oil
# Aiven cloud PostgreSQL (ssl required — see config/settings/base.py):
# DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxx.g.aivencloud.com:27344/defaultdb?sslmode=require
# Omit DATABASE_URL entirely to use SQLite (db.sqlite3) for local dev only.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
# Dev (config.settings.dev): Celery is eager + in-memory by default — Redis not required.
# For a real worker + Redis broker, set: USE_REDIS_CELERY=1 and run redis-server + celery worker.
# USE_REDIS_CELERY=1
# Include [::1] if the desktop app resolves "localhost" to IPv6. Add your LAN IP for phone/Expo hitting this machine.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.100
# CORS_ALLOW_ALL_ORIGINS is always True in config/settings/base.py (Tauri tauri://, LAN clients).
# CORS_ALLOWED_ORIGINS is kept for documentation; with allow-all, the response Origin matches the request.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
MANAGER_EMAIL=manager@example.com
GM_EMAIL=gm@example.com
# Optional: line included in welcome emails for GM-created users (app name, install notes, or URL)
FRONTEND_URL=open the desktop app to view the workflow
WELCOME_EMAIL_APP_HINT=Welcome to Chem-Solv Inventory

# Business / SLA (used by workflow & alerts apps)
SLA_DAYS=30
YELLOW_THRESHOLD=21
RED_THRESHOLD=26

# JWT (Simple JWT)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=60

# Mobile push (OneSignal — Docs/PUSH_NOTIFICATIONS.md)
# ONESIGNAL_APP_ID=e744024a-08b5-4703-a3ed-af0ac17e907f
# ONESIGNAL_REST_API_KEY=   # dashboard.onesignal.com → Settings → Keys & IDs
# ONESIGNAL_PUSH_ENABLED=true
