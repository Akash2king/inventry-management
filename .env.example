# Waste Oil Management System - Root Environment Template
# This is a reference file. Each component (backend, frontend) has its own .env.example file.
# Copy this and the component-specific .env.example files for development setup.

# ===========================
# Backend Configuration
# ===========================
# See waste_oil_backend/.env.example for detailed backend settings

# Database
# Default: sqlite at waste_oil_backend/db.sqlite3
# For production, use PostgreSQL:
# DATABASE_URL=postgres://user:password@db-host:5432/waste_oil

# Redis (optional for development, required for production)
# REDIS_URL=redis://127.0.0.1:6379/0

# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# ===========================
# Frontend Configuration
# ===========================
# See waste_oil_desktop/.env.example and waste_oil_desktop-TAURI/.env.example

# API Base URL (point to your backend)
# For local development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# For LAN development (replace 192.168.1.100 with your backend machine IP):
# VITE_API_BASE_URL=http://192.168.1.100:8000/api/v1

# ===========================
# Optional: Quick Start Helper
# ===========================
# After copying .env files to all directories:
#
# Terminal 1 - Backend:
#   cd waste_oil_backend
#   source .venv/bin/activate
#   python manage.py migrate
#   python manage.py seed_workflow_demo
#   python manage.py runserver 0.0.0.0:8000
#
# Terminal 2 - Electron Frontend:
#   cd waste_oil_desktop
#   npm install
#   npm run dev
#
# Terminal 3 - Tauri Frontend (alternative):
#   cd waste_oil_desktop-TAURI
#   npm install
#   npm run dev
